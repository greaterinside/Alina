# Supabase project (shared across tech/social/support/public schemas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI embeddings, used by match_knowledge retrieval (was Voyage AI —
# switched after persistent account-access problems)
OPENAI_API_KEY=

# Model used to compose Alina's answers from retrieved context
ANTHROPIC_API_KEY=

# GitHub App used by scripts/ingest-github.mjs to pull READMEs, ADRs, and
# merged-PR descriptions into tech.github_docs
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# ElevenLabs — voices "Hear this" / auto-speak in the Ask screen.
# ELEVENLABS_VOICE_ID is optional; defaults to a preset "Rachel" voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Fathom (fathom.video — the meeting notetaker, not usefathom.com) used by
# scripts/ingest-fathom.mjs to pull call transcripts/summaries into
# social.fathom_calls. Generated at developers.fathom.ai.
FATHOM_API_KEY=

# Notion internal integration token used by scripts/ingest-notion.mjs to
# pull pages/databases shared with it into tech.notion_docs. Generated at
# notion.so/my-integrations — no OAuth review needed, but each page must be
# explicitly shared with the integration (Share -> invite it by name).
NOTION_API_KEY=

# Optional — comma-separated page/database ids to fetch directly, for
# content the integration genuinely has access to but that never shows up
# in Notion's /v1/search results (confirmed real quirk: a workspace-level
# database, parent type "workspace" not a page, can be fully fetchable by
# id while invisible to search). Ids as they appear in a Notion URL (32
# hex chars, dashes optional) work fine.
NOTION_EXTRA_IDS=

# Tavily search API — powers the search_web tool in lib/rag.ts, so Alina
# can look things up on the live internet (not just the ingested knowledge
# base) during an Ask answer. Generated at tavily.com; free tier is 1,000
# searches/month. fetch_page (reading one page's content) needs no key.
TAVILY_API_KEY=

# Authenticates app/api/cron/sync-notion — Vercel signs its own cron
# requests with this exact value as a Bearer token (see vercel.json's
# schedule), so this keeps the endpoint from being a public URL anyone
# could hit to trigger a real sync run. Any long random string works;
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
